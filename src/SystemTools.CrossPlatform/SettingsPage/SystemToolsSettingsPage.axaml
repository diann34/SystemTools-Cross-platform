<ci:SettingsPageBase x:Class="SystemTools.CrossPlatform.SettingsPage.SystemToolsSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     x:CompileBindings="False">
    <!-- 阶段 1 A 档骨架（礼部 p1-06）+ 阶段 3 批次一整合（兵部 p3-01，落点权威 p3-05 §2.1/§3.4）：
         AI 服务选项组、「更多功能选项」导航（p1-06 既有）；
         W1「启用功能选项」管理抽屉（源 :167-176/:21-149/:524-558，枚举白名单=注册面，重启走
         SettingsPageBase.RequestRestart，源 RestartClassIsland 不迁）；W2「启用悬浮窗功能」开关组
         （源 :199-206/:88-91）；A 面补全：页头标签（源 :153-165）+「当前使用模型」显示项
         （源 :286-300，A 档 AiModel 消费适配）。源页 C 档面（实验性功能、扩展功能下载组、
         AI 语音/液态玻璃组）零迁入（p3-05 §3.1 C1-C13）。显示文案随源不改。 -->
    <ci:DrawerHost x:Name="DrawerHost"
                   DrawerPlacement="Right"
                   IsDrawerOpen="{Binding ViewModel.IsFeatureDrawerOpen, Mode=TwoWay}"
                   DrawerContent="{Binding ViewModel.FeatureDrawerContent}">

        <!-- W1 抽屉内容模板（源 SystemToolsSettingsPage.axaml:26-149 随源；DataGrid/DrawerHost 为
             ClassIsland.Core 双分支既有消费面，p3-05 §6-2） -->
        <ci:DrawerHost.DrawerContentTemplate>
            <DataTemplate>
                <Grid Width="500"
                      Background="{DynamicResource LayerFillColorDefaultBrush}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Height="44"
                          ColumnDefinitions="*,Auto"
                          Margin="16,0,12,0">
                        <TextBlock Grid.Column="0"
                                   Text="启用功能选项…"
                                   Theme="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Theme="{StaticResource TransparentButton}"
                                Click="OnCloseDrawerClick">
                            <ci:FluentIcon Glyph="&#xE0F6;" FontSize="19" />
                        </Button>
                    </Grid>

                    <TextBox x:Name="FeatureSearchTextBox"
                             Grid.Row="1"
                             Margin="16,0,16,8"
                             TextChanged="OnFeatureSearchTextBoxTextChanged"
                             PlaceholderText="搜索启用功能…" />

                    <Border Grid.Row="2"
                            Margin="16,0,16,12"
                            Padding="12,0"
                            Height="40"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ci:FluentIcon Glyph="&#xF430;"
                                           FontSize="17"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="改变配置后请记得点击“应用并重启”以应用您的设置"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="16,0,16,0"
                            BorderThickness="0">
                        <Grid>
                            <DataGrid AutoGenerateColumns="False"
                                      ItemsSource="{Binding DataContext.ViewModel.FeatureSearchResults,
                                                    RelativeSource={RelativeSource AncestorType=ci:SettingsPageBase}}"
                                      CanUserSortColumns="True"
                                      CanUserReorderColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                                <DataGrid.Styles>
                                    <Style Selector="DataGridRow TextBlock">
                                        <Setter Property="TextElement.FontSize" Value="13" />
                                    </Style>
                                    <Style Selector="DataGridRow">
                                        <Setter Property="Height" Value="32" />
                                    </Style>
                                </DataGrid.Styles>
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="启用"
                                                            Width="75"
                                                            Binding="{Binding IsEnabled, Mode=TwoWay}" />
                                    <DataGridTextColumn Header="类型"
                                                        Width="80"
                                                        IsReadOnly="True"
                                                        Binding="{Binding TypeDisplayName}" />
                                    <DataGridTextColumn Header="所属组别"
                                                        Width="132"
                                                        IsReadOnly="True"
                                                        Binding="{Binding GroupName}" />
                                    <DataGridTextColumn Header="名称"
                                                        Width="*"
                                                        IsReadOnly="True"
                                                        Binding="{Binding DisplayName}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Margin="0,50"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding DataContext.ViewModel.IsFeatureSearchEmpty,
                                                    RelativeSource={RelativeSource AncestorType=ci:SettingsPageBase}}">
                                <ci:Empty Text="找不到启用功能。" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4"
                          Height="68"
                          Margin="16,0,16,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <Button Content="取消"
                                    Click="OnCloseDrawerClick" />
                            <Button Classes="accent"
                                    Click="OnSaveFromDrawerClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ci:FluentIcon Glyph="&#xE06D;" FontSize="16" />
                                    <TextBlock Text="应用并重启" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                </Grid>
            </DataTemplate>
        </ci:DrawerHost.DrawerContentTemplate>

        <ScrollViewer>
            <StackPanel Classes="settings-container animated-intro">

                <!-- A 面补全：页头标签（源 :153-165 随源；[HidePageTitle] 下页头随源自绘） -->
                <Label FontSize="20"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    SystemTools
                </Label>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <ci:FluentIcon FontSize="56"
                                   Glyph="&#xE078;"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    <Label VerticalAlignment="Center" FontSize="28">功能 · 主设置</Label>
                </StackPanel>

                <!-- W1「启用功能选项」管理抽屉入口（源 :167-177 随源；清单枚举白名单见共享 VM
                     InitializeFeatureItems，C 条目零呈现，p3-05 §3.4-3） -->
                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE079;}"
                                             Header="启用功能选项"
                                             Description="选择需要本插件要启用的功能">
                    <controls:FASettingsExpander.Footer>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="管理启用的功能..."
                                    Width="165"
                                    Click="OnManageFeaturesClick" />
                        </StackPanel>
                    </controls:FASettingsExpander.Footer>
                </controls:FASettingsExpander>

                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE28E;}"
                                             Header="更多功能选项……"
                                             Description="在这里启用相对小众的 / 正处于预览阶段的更多功能"
                                             ActionIconSource="{ci:FluentIconSource &#xEC2E;}"
                                             Click="OnOpenMoreFeaturesClick"
                                             IsClickEnabled="True" />

                <!-- W2「启用悬浮窗功能」开关组（源 :199-206 随源，随源相对序位于「更多功能选项」与
                     「AI 服务」之间；成员 EnableFloatingWindowFeature MainConfigData.cs:332；重启等价
                     口径 p1-06 §9-7） -->
                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEA37;}"
                                             Header="启用悬浮窗功能"
                                             Description="关闭后将禁用悬浮窗相关全部功能">
                    <controls:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.EnableFloatingWindowFeature, Mode=TwoWay}"
                                      Click="OnFloatingFeatureToggleClick" />
                    </controls:FASettingsExpander.Footer>
                </controls:FASettingsExpander>

                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF005;}"
                                             Header="AI 服务"
                                             Description="配置兼容 OpenAI 格式的 AI 服务，供插件功能调用。">
                    <controls:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.EnableAiService, Mode=OneWay}"
                                      Click="AiServiceToggle_OnClick" />
                    </controls:FASettingsExpander.Footer>

                    <controls:FASettingsExpanderItem Content="供应商名称"
                                                     Description="用于标识当前配置的 AI 服务供应商。"
                                                     IsEnabled="{Binding Config.EnableAiService}">
                        <controls:FASettingsExpanderItem.Footer>
                            <TextBox Width="300"
                                     PlaceholderText="OpenAI"
                                     Text="{Binding Config.AiProviderName, Mode=TwoWay}" />
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>

                    <controls:FASettingsExpanderItem Content="API Key"
                                                     Description="请求服务时使用的 Bearer API 密钥。"
                                                     IsEnabled="{Binding Config.EnableAiService}">
                        <controls:FASettingsExpanderItem.Footer>
                            <TextBox Width="300"
                                     PasswordChar="*"
                                     PlaceholderText="sk-..."
                                     Text="{Binding Config.AiApiKey, Mode=TwoWay}" />
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>

                    <controls:FASettingsExpanderItem Content="API 请求地址"
                                                     Description="兼容 OpenAI 的 API 基址，例如 https://api.openai.com/v1。"
                                                     IsEnabled="{Binding Config.EnableAiService}">
                        <controls:FASettingsExpanderItem.Footer>
                            <TextBox Width="300"
                                     PlaceholderText="https://api.openai.com/v1"
                                     Text="{Binding Config.AiApiUrl, Mode=TwoWay}" />
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>

                    <controls:FASettingsExpanderItem Content="模型"
                                                     Description="从供应商获取可用模型并选择默认模型。"
                                                     IsEnabled="{Binding Config.EnableAiService}">
                        <controls:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox Width="200"
                                          ItemsSource="{Binding AvailableAiModels}"
                                          SelectedItem="{Binding Config.AiModel, Mode=TwoWay}"
                                          PlaceholderText="请先获取模型" />
                                <Button Width="92"
                                        Content="获取模型"
                                        Click="GetAiModelsButton_OnClick" />
                            </StackPanel>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>

                    <!-- A 面补全：「当前使用模型」显示项（源 :286-300 适配：源为 Vosk 语音识别模型
                         检查面（DependencyPaths，C13 不迁），按 p3-05 §3.4-2 改为 A 档 AiModel
                         只读消费；描述文案随适配调整，其余随源） -->
                    <controls:FASettingsExpanderItem Content="当前使用模型"
                                                     Description="当前 AI 服务使用的模型；可通过上方“获取模型”选择。">
                        <controls:FASettingsExpanderItem.Footer>
                            <TextBlock Text="{Binding Config.AiModel, Mode=OneWay}"
                                       MaxWidth="360"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                </controls:FASettingsExpander>

                <TextBlock Text="Programmer_Wang ©2026"
                           Foreground="Gray"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"
                           Opacity="0.7" />
            </StackPanel>
        </ScrollViewer>
    </ci:DrawerHost>
</ci:SettingsPageBase>